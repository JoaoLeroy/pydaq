  <property name="styleSheet">
   <string notr="true">
QWidget{
    background-color: rgb(64, 64, 64);
    color: rgb(255, 255, 255);
    font: 12pt "Helvetica";
}


QLabel{
    color: rgb(255, 255, 255);
}

QComboBox,
QLineEdit,
QPlainTextEdit,
QSpinBox,
QDoubleSpinBox{
    background-color: rgb(77, 77, 77);
    color: rgb(255, 255, 255);

    border-top: 1.5px solid rgb(46, 46, 46);
    border-left: 1.5px solid rgb(46, 46, 46);

    border-bottom: 1.5px solid rgb(166, 166, 166);
    border-right: 1.5px solid rgb(166, 166, 166);
}

QComboBox QAbstractItemView {
    background-color: rgb(77, 77, 77);
    color: rgb(255, 255, 255);
}

QComboBox QAbstractItemView::item:focus{
    background-color: rgb(140, 140, 140);
}

QComboBox::drop-down{
    image: url(:/imgs/imgs/drop_down_arrow.png);
    width: 11px;

    background-color: rgb(0, 79, 0);
    border-top: 2px solid rgb(127, 167, 127);
    border-left: 2px solid rgb(127, 167, 127);

    border-bottom: 2px solid rgb(0, 0, 0);
    border-right: 2px solid rgb(0, 0, 0);
}

QComboBox::drop-down:hover{
    background-color: rgb(0, 50, 0);
}

QComboBox::drop-down:pressed{
    border: 2px solid rgb(255, 255, 255);
}

QDoubleSpinBox::up-button,
QSpinBox::up-button{
    image: url(:/imgs/imgs/drop_up_arrow.png);
    width: 11px;

    background-color: rgb(0, 79, 0);
    border-top: 1.5px solid rgb(127, 167, 127);
    border-left: 1.5px solid rgb(127, 167, 127);

    border-bottom: 1.5px solid rgb(0, 0, 0);
    border-right: 1.5px solid rgb(0, 0, 0);
}

QDoubleSpinBox::down-button,
QSpinBox::down-button{
    image: url(:/imgs/imgs/drop_down_arrow.png);
    width: 11px;

    background-color: rgb(0, 79, 0);
    border-top: 1.5px solid rgb(127, 167, 127);
    border-left: 1.5px solid rgb(127, 167, 127);

    border-bottom: 1.5px solid rgb(0, 0, 0);
    border-right: 1.5px solid rgb(0, 0, 0);
}

QDoubleSpinBox::up-button:hover,
QDoubleSpinBox::down-button:hover,
QSpinBox::up-button:hover,
QSpinBox::down-button:hover{
    background-color: rgb(0, 50, 0);
}

QDoubleSpinBox::up-button:pressed,
QDoubleSpinBox::down-button:pressed,
QSpinBox::up-button:pressed,
QSpinBox::down-button:pressed{
    border: 2px solid rgb(255, 255, 255);
}

QDoubleSpinBox:disabled,
QSpinBox:disabled {
    background-color: rgb(50, 50, 50);

    border-top: 1.5px solid rgb(30, 30, 30);
    border-left: 1.5px solid rgb(30, 30, 30);

    border-bottom: 1.5px solid rgb(100, 100, 100);
    border-right: 1.5px solid rgb(100, 100, 100);

    color: rgb(150, 150, 150);
}

QPushButton{
    background-color: rgb(0, 79, 0);

    border-top: 1.5px solid rgb(127, 167, 127);
    border-left: 1.5px solid rgb(127, 167, 127);

    border-bottom: 1.5px solid rgb(0, 0, 0);
    border-right: 1.5px solid rgb(0, 0, 0);

    font: 12pt "Helvetica";
    text-align:center;
}

QPushButton:hover{
    background-color: rgb(0, 50, 0);
}

QPushButton:pressed{
    border: 2px solid rgb(255, 255, 255);
}

QPushButton#reload_devices{
    image: url(:/imgs/imgs/reload.png);
    width: 11px;
}

QRadioButton::indicator{
    border-radius: 6px;

    border-top: 1.5px solid rgb(0, 0, 0);
    border-left: 1.5px solid rgb(0, 0, 0);

    border-bottom: 1.5px solid rgb(160, 160, 160);
    border-right: 1.5px solid rgb(160, 160, 160);
}

QRadioButton::indicator::checked{
    background-color: white;
}

QRadioButton::indicator::unchecked:hover{
    background-color: #9F9F9F;
}

QRadioButton::indicator::pressed{
    border: 1.5px solid #505050;
}

QLabel::toolTip {
    font: 12pt "Helvetica";
    color: white;
    background-color: rgb(64, 64, 64);
}
